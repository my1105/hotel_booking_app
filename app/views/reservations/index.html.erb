<h1>予約一覧</h1>

<% if @reservations.any? %>
  <% @reservations.each do |reservation| %>
    <div>
      <h3><%= reservation.room.name %></h3>
      <p>チェックイン: <%= reservation.check_in %></p>
      <p>チェックアウト: <%= reservation.check_out %></p>
      <p>人数: <%= reservation.people %>人</p>
    </div>
    <hr>
  <% end %>
<% else %>
  <p>まだ予約はありません</p>
<% end %>

<%= link_to "トップに戻る", root_path %>