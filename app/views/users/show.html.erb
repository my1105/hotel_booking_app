<h1>マイページ</h1>

<p><strong>名前:</strong> <%= @user.name %></p>
<p><strong>メール:</strong> <%= @user.email %></p>

<hr>

<h2>自分の登録した施設</h2>

<% if @user.rooms.any? %>
  <% @user.rooms.each do |room| %>
    <div>
      <h3><%= link_to room.name, room_path(room) %></h3>
      <p><%= room.description %></p>
    </div>
    <hr>
  <% end %>
<% else %>
  <p>まだ施設を登録していません</p>
<% end %>